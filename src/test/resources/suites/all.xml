<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Tests" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="org.example.framework.listeners.RetryTransformer"/>
        <listener class-name="org.example.framework.listeners.TestListener"/>
    </listeners>

    <test name="All Tests">
        <packages>
            <package name="org.example.framework.tests"/>
        </packages>
    </test>
</suite>
